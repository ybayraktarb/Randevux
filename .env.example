# ─────────────────────────────────────────────────────────────────────────────
# RandevuX — Ortam Değişkenleri Örneği
# Kullanım: Bu dosyayı kopyala → .env.local olarak yeniden adlandır → değerleri doldur
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────


# ─── Public (Client + Server tarafında erişilebilir) ─────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Supabase Dashboard → Settings → API → Project URL

NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Supabase Dashboard → Settings → API → anon public
# Bu key RLS kurallarına tabidir; client'a açılması güvenlidir.


# ─── Gizli (Yalnızca Server tarafında kullanılmalı) ──────────────────────────

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Supabase Dashboard → Settings → API → service_role (Secret)
# ⚠️  NEXT_PUBLIC_ yapma — tüm RLS kurallarını atlar, tam yetki verir.
# ⚠️  Yalnızca Server Action veya API Route içinde kullan.


# ─── Sentry ──────────────────────────────────────────────────────────────────

SENTRY_DSN=your-sentry-dsn-here
# Sentry Dashboard → Settings → Projects → [proje] → Client Keys (DSN)

NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
# Aynı DSN — client tarafında da erişilmesi gerekiyor.

SENTRY_ORG=your-org-slug
# Sentry Dashboard → Settings → Organization Slug

SENTRY_PROJECT=randevux
# Sentry Dashboard → Projects → proje adı

SENTRY_AUTH_TOKEN=your-auth-token-here
# Sentry Dashboard → Settings → Auth Tokens → Create new token
# ⚠️  Gizli — NEXT_PUBLIC_ yapma. Source map yüklemesi için gerekli.

